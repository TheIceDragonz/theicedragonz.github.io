// 1. License Activation Notification
async function sendDiscordLicenseNotification(info, webhookUrl) {
    if (!webhookUrl) return;
    try {
        const maskedKey = info.key && info.key.length > 10
            ? `${info.key.substring(0, 8)}...${info.key.substring(info.key.length - 4)}`
            : info.key;

        const embed = {
            title: "🔑 New License Activated!",
            color: 0x00f0ff,
            fields: [
                { name: "Avatar", value: `**${info.avatar}**`, inline: true },
                { name: "Platform", value: `**${info.provider}**`, inline: true },
                { name: "Uses", value: `${info.uses}`, inline: true },
                { name: "VRChat / Info", value: info.description ? `\`${info.description}\`` : "*No info*", inline: false },
                { name: "Buyer Email", value: info.email || "*Hidden / Not available*", inline: true },
                { name: "Key", value: `\`${maskedKey}\``, inline: true }
            ],
            footer: { text: "Ice License Manager • License Activation" },
            timestamp: new Date().toISOString()
        };

        await fetch(webhookUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                username: "Ice License Bot",
                embeds: [embed]
            })
        });
    } catch (err) {
        console.error("Discord license notify error:", err);
    }
}

